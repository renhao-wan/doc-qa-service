# 环境变量模板。用法：cp .env.example .env，然后填入真实值。
#
# docker compose 会自动读取与本文件同目录的 .env，无需任何额外参数。
# ⚠️ .env 已被 .gitignore 排除，切勿把真实密钥提交进版本库。

# 阿里云百炼 API Key。对话模型与向量模型共用这一把。
# 不设置的话 `docker compose up` 会直接报错退出（见 docker-compose.yml 的 app 服务），
# 这是刻意的：静默启动出一个每次问答都失败的容器，比启动就失败难排查得多
DASHSCOPE_API_KEY=

# JWT 签名密钥。留空则沿用 application-dev.yml 里的开发默认值——那串默认值是公开的，
# 只够本地演示用，部署到公网前必须在这里覆盖。
# ⚠️ 不少于 32 字节：短于 32 字节 jjwt 会抛 WeakKeyException 导致启动失败；
#    另外 jjwt 会按键长自动选算法（≥64 字节 HS512 / ≥48 HS384 / ≥32 HS256）
JWT_SECRET=

# ── 部署相关 ──
# 要部署的镜像 tag（git sha）。由 CD workflow 自动写入服务器上的 .env，本地无需设置；
# 本地不设时 compose 会用 :local，配合 docker compose up -d --build 构建
IMAGE_TAG=

# 激活的 Spring profile。本地留空即用 dev；服务器上必须显式写 prod
# ⚠️ prod 与 dev 的区别不只是 host —— dev 的迁移目录含演示账号、JWT 密钥是公开默认值
SPRING_PROFILES_ACTIVE=

# web 服务映射到宿主机的端口。Windows 的 80 常被 IIS 占用，故本地默认 8081；服务器上设为 80
WEB_HTTP_PORT=
# web 的 HTTPS 端口。本地默认 8443；服务器上设为 443
WEB_HTTPS_PORT=

# SearXNG 会话签名密钥。留空则用 compose 里的开发默认值，公网部署必须覆盖
SEARXNG_SECRET=

# 聚合的搜索引擎（逗号分隔）。默认取 application-{profile}.yml 里的 searxng.engines，
# 通常不用设。要用它覆盖时请填**完整**列表 ——
# ⚠️ 不要写成空值：空字符串会被当成有效值，把 yml 里的默认集合覆盖掉
# SEARXNG_ENGINES=360search,naver
